__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Built database — regenerated from schema.sql + seed data
*.db
*.sqlite
*.sqlite3
# metrics.db runs in WAL mode, and *.db does not match its sidecars
*.db-wal
*.db-shm

# Cached source documents
data/cache/

.DS_Store
.pytest_cache/
.ruff_cache/

# Research batches: fetched source documents are not ours to redistribute, and
# unverified model output must not sit in the tree looking like corpus.
docs/research/inbox/*
!docs/research/inbox/.gitkeep
docs/research/outbox/*
!docs/research/outbox/.gitkeep
# accepted/ IS committed: a verified figure with a quote that survives verbatim
# matching is worth keeping in history even before it becomes corpus.
